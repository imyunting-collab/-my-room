{
  "name": "my-room",
  "private": true,
  "version": "1.0.0",
  "description": "MY ROOM｜我的像素生活 — 閱讀養成 × 像素生活 × 房間裝潢 × 戀愛互動",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --serve",
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/build.mjs && node tests/run-tests.mjs",
    "test:unit": "node tests/run-tests.mjs --unit",
    "preview": "node scripts/serve.mjs dist 4173"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "typescript": "^5.6.0"
  }
}
